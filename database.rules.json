{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".indexOn": [
        "expiresAt"
      ],
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.child('players/p1/uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('expiresAt').val() < now))",
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{4}$/) && newData.hasChildren(['createdAt', 'expiresAt', 'status', 'players', 'firstPlayer', 'gameNumber', 'score'])",
        "createdAt": {
          ".validate": "newData.isNumber() && !data.exists()"
        },
        "expiresAt": {
          ".write": "auth != null && (root.child('rooms/' + $code + '/players/p1/uid').val() === auth.uid || root.child('rooms/' + $code + '/players/p2/uid').val() === auth.uid)",
          ".validate": "newData.isNumber() && newData.val() <= now + 90000000"
        },
        "status": {
          ".write": "auth != null && (root.child('rooms/' + $code + '/players/p1/uid').val() === auth.uid || root.child('rooms/' + $code + '/players/p2/uid').val() === auth.uid)",
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "players": {
          "p1": {
            ".validate": "newData.hasChildren(['uid', 'name', 'color'])",
            "uid": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)"
            },
            "$other": {
              ".validate": false
            }
          },
          "p2": {
            ".validate": "newData.hasChildren(['uid', 'name', 'color'])",
            "uid": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z]{2,12}$/)"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/' + $code + '/players/p1/uid').val() !== auth.uid"
          },
          "$other": {
            ".validate": false
          }
        },
        "moves": {
          ".write": "(auth != null && (root.child('rooms/' + $code + '/players/p1/uid').val() === auth.uid || root.child('rooms/' + $code + '/players/p2/uid').val() === auth.uid)) && (newData.exists() || newData.parent().child('gameNumber').val() === data.parent().child('gameNumber').val() + 1)",
          ".validate": "newData.isString() && newData.val().matches(/^[0-6]{1,42}$/) && newData.parent().child('status').val() === 'playing' && ((!data.exists() && newData.val().length === 1) || (data.exists() && newData.val().length === data.val().length + 1 && newData.val().beginsWith(data.val()))) && ((((((!data.exists() || data.val().length % 2 === 0) && newData.parent().child('firstPlayer').val() === 'p1') || (!(!data.exists() || data.val().length % 2 === 0) && newData.parent().child('firstPlayer').val() === 'p2')) && auth.uid === newData.parent().child('players/p1/uid').val())) || ((((!data.exists() || data.val().length % 2 === 0) && newData.parent().child('firstPlayer').val() === 'p2') || (!(!data.exists() || data.val().length % 2 === 0) && newData.parent().child('firstPlayer').val() === 'p1')) && auth.uid === newData.parent().child('players/p2/uid').val()))"
        },
        "gameNumber": {
          ".write": "auth != null && (root.child('rooms/' + $code + '/players/p1/uid').val() === auth.uid || root.child('rooms/' + $code + '/players/p2/uid').val() === auth.uid)",
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1 && !newData.parent().child('moves').exists() && data.parent().child('rematch/p1').val() === true && data.parent().child('rematch/p2').val() === true))"
        },
        "firstPlayer": {
          ".write": "auth != null && (root.child('rooms/' + $code + '/players/p1/uid').val() === auth.uid || root.child('rooms/' + $code + '/players/p2/uid').val() === auth.uid)",
          ".validate": "(newData.val() === 'p1' || newData.val() === 'p2') && (!data.exists() || newData.parent().child('gameNumber').val() === data.parent().child('gameNumber').val() + 1)"
        },
        "score": {
          ".write": "auth != null && (root.child('rooms/' + $code + '/players/p1/uid').val() === auth.uid || root.child('rooms/' + $code + '/players/p2/uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['p1', 'p2', 'draws']) && (!data.exists() || newData.parent().child('gameNumber').val() === data.parent().child('gameNumber').val() + 1)",
          "p1": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "p2": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "draws": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "rematch": {
          ".write": "(auth != null && (root.child('rooms/' + $code + '/players/p1/uid').val() === auth.uid || root.child('rooms/' + $code + '/players/p2/uid').val() === auth.uid)) && !newData.exists() && newData.parent().child('gameNumber').val() === data.parent().child('gameNumber').val() + 1",
          "$seat": {
            ".write": "auth != null && root.child('rooms/' + $code + '/players/' + $seat + '/uid').val() === auth.uid",
            ".validate": "($seat === 'p1' || $seat === 'p2') && newData.isBoolean()"
          }
        },
        "reactions": {
          "$seat": {
            ".write": "auth != null && root.child('rooms/' + $code + '/players/' + $seat + '/uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['e', 'at'])",
            "e": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "left": {
          "$seat": {
            ".write": "auth != null && root.child('rooms/' + $code + '/players/' + $seat + '/uid').val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "presence": {
      "$code": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}